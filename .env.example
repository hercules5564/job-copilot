# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://jobcopilot:jobcopilot@localhost:5433/jobcopilot?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
WEB_PORT=3000
API_BASE_URL="http://localhost:4000"

# Auth (Google OAuth — Phase 1: structure only, full flow in later phase)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Phase 9: Gmail callback (must be registered in Google Cloud Console).
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/gmail/callback"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
FRONTEND_URL="http://localhost:3000"

# Phase 9: application sign-in (Google OIDC + server-side sessions).
# Client id/secret fall back to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above,
# so a second OAuth client is optional; the redirect URI below MUST be
# registered in Google Cloud Console and MUST differ from GOOGLE_REDIRECT_URI.
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
# HMAC secret for OAuth state tokens (min 32 chars). Falls back to
# SESSION_SECRET. Never commit real secrets, never log this value.
AUTH_SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Explicit dev/test auth bypass. NEVER true in production (ignored there).
AUTH_DEV_BYPASS="false"

# Phase 6: Gmail integration (read-only). All server-side; never commit secrets.
# Without GOOGLE_CLIENT_ID/SECRET the app still builds and Gmail reports
# "configuration required". Tokens are AES-256-GCM encrypted with:
INTEGRATION_ENCRYPTION_KEY="change-me-to-a-long-random-string-min-32-chars"
# Bounded sync default (hard cap 100):
GMAIL_SYNC_MAX_MESSAGES=25

# Legacy/placeholder AI keys (Phase 5 era). UNUSED by the application —
# generation uses AI_GENERATION_PROVIDER/AI_LLM_* below, embeddings use
# AI_API_KEY/AI_EMBEDDING_*. Kept as reserved names; safe to leave empty.
LLM_PROVIDER="stub"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Phase 5: semantic/hybrid job matching (all optional — defaults keep the app
# fully offline on the deterministic matcher; never commit real secrets)
MATCH_PROVIDER="deterministic"
# EMBEDDING_PROVIDER: "local" (default, offline token-hash embeddings, no
# credentials) or "openai" (OpenAI-compatible embeddings API, needs AI_API_KEY)
EMBEDDING_PROVIDER="local"
AI_API_KEY=""
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
AI_EMBEDDING_TIMEOUT_MS=15000
HYBRID_DETERMINISTIC_WEIGHT=70
HYBRID_SEMANTIC_WEIGHT=30

# Phase 15: AI application personalization (structured drafts, review-gated).
# All server-side; the app works fully offline when unconfigured ("off").
# AI_GENERATION_PROVIDER: "off" (default) | "openai" (OpenAI-compatible chat
# API, needs AI_LLM_API_KEY) | "test" (deterministic offline fixture for
# automated tests; refused in production — never commit real secrets)
AI_GENERATION_PROVIDER="off"
AI_LLM_API_KEY=""
AI_LLM_MODEL="gpt-4o-mini"
AI_LLM_BASE_URL="https://api.openai.com/v1"
AI_LLM_TIMEOUT_MS=30000
AI_LLM_MAX_OUTPUT_TOKENS=1500

# Phase 3: job sources (no credentials needed — all sources are keyless
# public APIs or local mocks; never commit secrets here)
ARBEITNOW_API_URL="https://www.arbeitnow.com/api/job-board-api"
JOB_SOURCE_TIMEOUT_MS=10000

# Phase 20: additional public job sources.
# RemoteOK is keyless. Adzuna and Jooble need free API credentials; without
# them those sources report "not configured" and are skipped.
REMOTEOK_API_URL="https://remoteok.com/api"
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="us"
JOOBLE_API_KEY=""

# Phase 7/8: browser-assisted applications (all optional — safe defaults).
# BROWSER_PROVIDER: "playwright" (default, headless Chromium) or "demo" (in-memory).
BROWSER_PROVIDER="playwright"
# BROWSER_PROVIDER_DEMO=playwright runs the demo adapter on real Chromium (local verification only).
# BROWSER_PROVIDER_DEMO="demo"
# BROWSER_HEADED=1 opens a visible window for manual login (headless by default).
# BROWSER_HEADED=0
# Resource caps (active sessions):
BROWSER_MAX_SESSIONS_PER_USER=3
BROWSER_MAX_SESSIONS=20

# Phase 10A: background workers (BullMQ + Redis). Queue payloads carry
# references only — never tokens, cookies, passwords, or email bodies.
# Start Redis with: docker compose up -d redis
# Start the worker with: npm run worker  (prod: npm run worker:start)
WORKER_ENABLED="true"
WORKER_SHUTDOWN_TIMEOUT_MS=30000
QUEUE_INGESTION_CONCURRENCY=2
QUEUE_MATCHING_CONCURRENCY=2
QUEUE_GMAIL_CONCURRENCY=1
QUEUE_NOTIFICATION_CONCURRENCY=2
QUEUE_ANALYTICS_CONCURRENCY=2
# Repeatable schedules are all disabled by default (opt in per schedule).
QUEUE_SCHEDULE_ANALYTICS="false"

# Storage (Phase 1: local stub; S3/Supabase later). UNUSED by the
# application — reserved names only.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""