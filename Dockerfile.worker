# JobPilot worker — production image (BullMQ, no HTTP).
# Build context: repository root.
FROM node:20-slim
WORKDIR /app
# Same OpenSSL requirement as the API image (Prisma engines).
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/queues/package.json packages/queues/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY . .
RUN npm run db:generate --workspace=packages/db \
 && npm run build --workspace=packages/shared --workspace=packages/db --workspace=packages/queues --workspace=apps/api --workspace=apps/worker
ENV NODE_ENV=production
CMD ["node", "apps/worker/dist/worker/src/index.js"]
