# JobPilot API — environment template.
# The monorepo root `.env.example` is the authoritative reference for every
# variable below; this file exists so the API package documents its own
# runtime surface. Copy the root file instead: `Copy-Item .env.example .env`.
# Never commit real secrets.

# --- Required ---
# PostgreSQL connection (API 503s DB routes without it).
DATABASE_URL="postgresql://jobcopilot:jobcopilot@localhost:5433/jobcopilot?schema=public"
# HMAC secret for OAuth state + sessions (min 32 chars). Auth 503s without it.
AUTH_SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# AES-256-GCM key for Gmail tokens (min 32 chars). Required for Gmail connect.
INTEGRATION_ENCRYPTION_KEY="change-me-to-a-long-random-string-min-32-chars"

# --- Auth (Google OIDC sign-in; falls back to GOOGLE_CLIENT_ID/SECRET) ---
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
# --- Gmail integration (read-only; separate OAuth registration) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/gmail/callback"

# --- URLs / ports ---
API_PORT=4000
FRONTEND_URL="http://localhost:3000"

# --- Workers / queues (BullMQ + Redis) ---
REDIS_URL="redis://localhost:6379"
WORKER_ENABLED="true"

# --- AI personalization (all server-side; "off" = drafts disabled with 409) ---
AI_GENERATION_PROVIDER="off"
AI_LLM_API_KEY=""
AI_LLM_BASE_URL="https://api.openai.com/v1"
AI_LLM_MODEL="gpt-4o-mini"
AI_LLM_TIMEOUT_MS=30000
AI_LLM_MAX_OUTPUT_TOKENS=1500

# --- Dev/test ONLY: header auth bypass. Ignored when NODE_ENV=production. ---
AUTH_DEV_BYPASS="false"

# --- Billing (monthly/yearly subscriptions) ---
# "razorpay" for live payments, "mock" for local development, "disabled" off.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_ALLOW_MOCK="true"
# Hosted checkout uses Razorpay Payment Links (redirects to short_url).
# Subscribe the webhook to payment_link.paid (and optionally payment.captured).
